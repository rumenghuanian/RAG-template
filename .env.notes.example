# Agent 笔记助手的环境变量
# 用法：Copy-Item .env.notes.example .env.notes  然后填 LLM_API_KEY
# main_agent.py 会优先读 .env.notes

# ===== LLM（必须是支持 function calling / 工具调用的模型）=====
# 实测 deepseek-flash 支持工具调用；若不支持可换 deepseek-chat / qwen-plus / gpt-4o-mini
# 用 `python main_agent.py --check` 验证
LLM_MODEL=deepseek-flash
LLM_BASE_URL=https://api.deepseek.com/v1
# 这里必须是空的！密钥填到 .env.notes（已被 .gitignore 挡掉），别填在模板里
LLM_API_KEY=

# ===== Embedding =====
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DEVICE=cpu

# ===== 语料：Agent-100-Days 的 99 篇课程笔记 =====
# 路径相对项目根目录（basic_rag/）
DATA_PATH=../Agent-100-Days
# 只收 weekN/NN.标题.md，自动排除 .venv / .ipynb_checkpoints / 代码目录
FILE_GLOB=week*/*.md
# 按 skill 分索引目录，别和 recipe 的索引串用
INDEX_SAVE_PATH=./vector_index/notes

# ===== 检索/生成参数 =====
TOP_K=5
TEMPERATURE=0.1
MAX_TOKENS=2048
CONTEXT_MAX_TOKENS=6000
ENABLE_REWRITE=false
# 相关性闸门（余弦相似度）：只能过滤「完全跑题」，不能判断相关性。
# 三类标注实测：可答最低 0.5538，真·语料外最高 0.6729（重叠），
# 「术语出现但答不了」最高 0.6066（重叠）。不存在能分开的阈值。
MIN_RELEVANCE=0.45

# ===== 重排序（cross-encoder）=====
# 实测总体 hit@5 84.2% → 89.5%，multi 覆盖率 46.7% → 53.3%。
# 但**设备决定了它能不能用**（实测 RTX 3050 Ti vs CPU）：
#   RERANK_DEVICE=cuda → 一次检索 0.78s（50 条，15ms/条）
#   RERANK_DEVICE=cpu  → 一次检索 13s（266ms/条，慢 17 倍）
# 用 cuda 需要装 CUDA 版 torch：
#   pip install https://download.pytorch.org/whl/cu126/torch-2.14.0%2Bcu126-cp311-cp311-win_amd64.whl
#   （别用 --index-url，索引页指向的 download-r2.pytorch.org 会返回 403）
RERANK_ENABLED=true
RERANK_MODEL=BAAI/bge-reranker-base
# 0 = 不截断，重排 RRF 的整个候选池（实测 88~95 条，GPU 约 1.2s）。
# 截到 50 会让 2/38 篇 gold 连候选都进不去，所以默认不截断。
RERANK_CANDIDATES=0
# 留空则跟随 EMBEDDING_DEVICE
# RERANK_DEVICE=cuda

# ===== 可选：模型缓存与离线模式 =====
# HF_HOME=./.cache/huggingface
# HF_HUB_OFFLINE=1
# TRANSFORMERS_OFFLINE=1
