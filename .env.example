# ===== LLM 配置（OpenAI 兼容接口，任意服务商都行）=====
LLM_MODEL=deepseek-flash
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=

# ===== Embedding 配置 =====
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DEVICE=cpu

# ===== 数据路径 =====
# 菜谱语料所在目录（rglob 递归找，所以给 ./data/cook 也能找到 ./data/cook/dishes 下的）
DATA_PATH=./data/cook
# **按 skill 分索引目录**：notes 用 ./vector_index/notes，recipe 用 ./vector_index/recipe。
# 两份语料的索引必须物理隔离，否则换 skill 会互相覆盖。
INDEX_SAVE_PATH=./vector_index/recipe
# FILE_GLOB=*.md

# ===== 可选：HuggingFace 模型缓存位置（默认在 C 盘用户目录下）=====
# HF_HOME=./.cache/huggingface

# ===== 可选：离线模式（避免每次启动都去 HEAD huggingface 检查版本）=====
# 前提：模型已完整下载到本地
# HF_HUB_OFFLINE=1
# TRANSFORMERS_OFFLINE=1

# ===== 检索/生成参数（可选）=====
TOP_K=3
TEMPERATURE=0.1
MAX_TOKENS=2048
ENABLE_REWRITE=true
# 送进 prompt 的上下文预算（约等于 token 数），要小于模型窗口
CONTEXT_MAX_TOKENS=6000

# ===== 重排序（cross-encoder，可选）=====
# 关掉就是纯 RRF 排序；权重缺失/依赖缺失会自动退化并打 WARNING。
# 模型约 1.1GB。**设备决定可用性**：cuda 约 0.78s/次检索，cpu 约 13s（差 17 倍）。
# 用 cuda 要先装 CUDA 版 torch（见 README「重排序」一节）。
RERANK_ENABLED=true
RERANK_MODEL=BAAI/bge-reranker-base
# 0 = 不截断（重排整个 RRF 候选池）
RERANK_CANDIDATES=0
# 留空则跟随 EMBEDDING_DEVICE
# RERANK_DEVICE=cuda
